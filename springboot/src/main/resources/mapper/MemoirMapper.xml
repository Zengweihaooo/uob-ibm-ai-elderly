<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.MemoirMapper">

  <!-- 结果映射：项目 -->
  <resultMap id="MemoirProjectMap" type="com.example.demo.pojo.memoir.MemoirProject">
    <id column="id" property="id" />
    <result column="title" property="title" />
    <result column="owner" property="owner" />
    <result column="locale" property="locale" />
    <result column="pin_hash" property="pinHash" />
    <result column="created_at" property="createdAt" />
    <result column="updated_at" property="updatedAt" />
  </resultMap>

  <!-- 结果映射：分段 -->
  <resultMap id="MemoirSegmentMap" type="com.example.demo.pojo.memoir.MemoirSegment">
    <id column="id" property="id" />
    <result column="project_id" property="projectId" />
    <result column="chapter" property="chapter" />
    <result column="theme" property="theme" />
    <result column="prompt_id" property="promptId" />
    <result column="order_index" property="orderIndex" />
    <result column="text" property="text" />
    <result column="audio_url" property="audioUrl" />
    <result column="tags" property="tags" />
    <result column="created_at" property="createdAt" />
    <result column="updated_at" property="updatedAt" />
  </resultMap>

  <!-- 结果映射：分享令牌 -->
  <resultMap id="MemoirShareTokenMap" type="com.example.demo.pojo.memoir.MemoirShareToken">
    <id column="id" property="id" />
    <result column="project_id" property="projectId" />
    <result column="token" property="token" />
    <result column="expires_at" property="expiresAt" />
    <result column="scope" property="scope" />
    <result column="created_at" property="createdAt" />
  </resultMap>

  <!-- 结果映射：分享守护 -->
  <resultMap id="MemoirShareGuardMap" type="com.example.demo.pojo.memoir.MemoirShareGuard">
    <id column="id" property="id" />
    <result column="share_id" property="shareId" />
    <result column="pin_hash" property="pinHash" />
    <result column="max_downloads" property="maxDownloads" />
    <result column="download_count" property="downloadCount" />
    <result column="created_at" property="createdAt" />
  </resultMap>

  <!-- 插入项目 -->
  <insert id="insertProject" parameterType="com.example.demo.pojo.memoir.MemoirProject" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO memoir_project(title, owner, locale, pin_hash)
    VALUES(#{title}, #{owner}, #{locale}, #{pinHash})
  </insert>

  <!-- 按ID查询项目 -->
  <select id="findProjectById" parameterType="int" resultMap="MemoirProjectMap">
    SELECT * FROM memoir_project WHERE id = #{id}
  </select>

  <!-- 按owner列出项目；owner可为空（返回所有） -->
  <select id="listProjectsByOwner" parameterType="string" resultMap="MemoirProjectMap">
    SELECT * FROM memoir_project
    <where>
      <if test="owner != null and owner != ''">
        owner = #{owner}
      </if>
    </where>
    ORDER BY id DESC
  </select>

  <!-- 插入分段 -->
  <insert id="insertSegment" parameterType="com.example.demo.pojo.memoir.MemoirSegment" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO memoir_segment(project_id, chapter, theme, prompt_id, order_index, text, audio_url, tags)
    VALUES(#{projectId}, #{chapter}, #{theme}, #{promptId}, #{orderIndex}, #{text}, #{audioUrl}, #{tags})
  </insert>

  <!-- 按项目列出分段 -->
  <select id="listSegmentsByProject" parameterType="int" resultMap="MemoirSegmentMap">
    SELECT * FROM memoir_segment WHERE project_id = #{projectId} ORDER BY order_index ASC, id ASC
  </select>

  <!-- 插入分享令牌 -->
  <insert id="insertShareToken" parameterType="com.example.demo.pojo.memoir.MemoirShareToken" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO memoir_share_token(project_id, token, expires_at, scope)
    VALUES(#{projectId}, #{token}, #{expiresAt}, #{scope})
  </insert>

  <!-- 按 token 查询分享令牌 -->
  <select id="findShareByToken" parameterType="string" resultMap="MemoirShareTokenMap">
    SELECT * FROM memoir_share_token WHERE token = #{token}
  </select>

  <!-- 插入分享守护 -->
  <insert id="insertShareGuard" parameterType="com.example.demo.pojo.memoir.MemoirShareGuard" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO memoir_share_guard(share_id, pin_hash, max_downloads, download_count)
    VALUES(#{shareId}, #{pinHash}, #{maxDownloads}, #{downloadCount})
  </insert>

  <!-- 查询分享守护 -->
  <select id="findShareGuard" parameterType="int" resultMap="MemoirShareGuardMap">
    SELECT * FROM memoir_share_guard WHERE share_id = #{shareId}
  </select>

  <!-- 增加下载计数 -->
  <update id="incrementDownloadCount">
    UPDATE memoir_share_guard
    SET download_count = COALESCE(download_count,0) + 1
    WHERE share_id = #{shareId}
  </update>

</mapper>
