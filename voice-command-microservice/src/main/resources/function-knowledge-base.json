{
  "functions": [
    {
      "name": "send_email",
      "description": "Send email function",
      "parameters": {
        "toEmail": {
          "type": "string",
          "required": true,
          "description": "Recipient email address"
        },
        "subject": {
          "type": "string",
          "required": true,
          "description": "Email subject"
        },
        "content": {
          "type": "string",
          "required": true,
          "description": "Email content"
        },
        "fromEmail": {
          "type": "string",
          "required": false,
          "description": "Sender email (optional, system default if omitted)"
        }
      },
      "examples": [
        "Send an email to Zhang San, subject: meeting reminder, content: meeting at 3 PM tomorrow",
        "Send an email to Li Si, tell him about tomorrow's meeting",
        "Write an email to Wang Wu about the project progress"
      ],
      "keywords": ["email", "send", "write email"],
      "endpoint": "/api/email/send"
    },
    {
      "name": "check_health",
      "description": "Health check function",
      "parameters": {
        "userId": {
          "type": "string",
          "required": true,
          "description": "User ID"
        }
      },
      "examples": [
        "Check my health status",
        "View health report",
        "Health check"
      ],
      "keywords": ["health", "check", "status", "report"],
      "endpoint": "/api/health/check"
    },
    {
      "name": "add_schedule",
      "description": "Add schedule function",
      "parameters": {
        "title": {
          "type": "string",
          "required": true,
          "description": "Schedule title"
        },
        "date": {
          "type": "string",
          "required": true,
          "description": "Schedule date (YYYY-MM-DD)"
        },
        "time": {
          "type": "string",
          "required": true,
          "description": "Schedule time (HH:MM)"
        },
        "category": {
          "type": "string",
          "required": true,
          "description": "Schedule category (morning, afternoon, evening, medication)"
        },
        "description": {
          "type": "string",
          "required": false,
          "description": "Schedule description (optional)"
        },
        "priority": {
          "type": "string",
          "required": false,
          "description": "Priority (high, medium, low; default medium)"
        }
      },
      "examples": [
        "Add a meeting at 3 PM tomorrow",
        "Set a medication reminder at 8 AM tomorrow",
        "Schedule a movie at 7 PM the day after tomorrow",
        "Add a doctor's appointment at 9 AM next Monday"
      ],
      "keywords": ["schedule", "add", "set", "appointment"],
      "endpoint": "/api/schedule/activity"
    },
    {
      "name": "add_important_date",
      "description": "Add important date function",
      "parameters": {
        "title": {
          "type": "string",
          "required": true,
          "description": "Important date title"
        },
        "date": {
          "type": "string",
          "required": true,
          "description": "Important date (YYYY-MM-DD)"
        },
        "type": {
          "type": "string",
          "required": true,
          "description": "Important date type (birthday, anniversary, holiday, custom)"
        },
        "description": {
          "type": "string",
          "required": false,
          "description": "Important date description (optional)"
        }
      },
      "examples": [
        "Add Zhang San's birthday on December 25",
        "Set wedding anniversary on June 15",
        "Add Spring Festival on February 10",
        "Set mom's birthday on March 8"
      ],
      "keywords": ["important date", "birthday", "anniversary", "holiday", "add", "set"],
      "endpoint": "/api/important-dates/add"
    },
    {
      "name": "set_reminder",
      "description": "Set reminder function",
      "parameters": {
        "title": {
          "type": "string",
          "required": true,
          "description": "Reminder title"
        },
        "datetime": {
          "type": "string",
          "required": true,
          "description": "Reminder time"
        },
        "description": {
          "type": "string",
          "required": false,
          "description": "Reminder description (optional)"
        }
      },
      "examples": [
        "Set a meeting reminder at 3 PM tomorrow",
        "Remind me to take medicine",
        "Set a birthday reminder"
      ],
      "keywords": ["reminder", "set", "alarm", "time"],
      "endpoint": "/api/reminder/set"
    }
  ]
}

